# Integration Hub dev environment (copy to .env or export in your shell).
# Without DATABASE_URL the hub runs on the in-memory stores.

# PostgreSQL (matches docker-compose.yml; host port 5434 avoids clashing with
# other local projects that bind 5432)
DATABASE_URL=postgres://hub:hub@localhost:5434/hub

# Hub binding
HOST=127.0.0.1
PORT=3000
DEVICE_PORT=5000