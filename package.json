{
  "name": "integration-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Healthcare device integration & interoperability platform (MVP scaffold)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsx --test --test-concurrency=1 \"packages/**/*.test.ts\"",
    "test:db": "TEST_DATABASE_URL=postgres://hub:hub@localhost:5434/hub tsx --test --test-concurrency=1 \"packages/**/*.test.ts\"",
    "start": "tsx packages/server/src/cli.ts",
    "simulate": "tsx packages/simulator/src/cli.ts",
    "simulate:hl7": "tsx packages/simulator/src/cli-hl7.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:hl7": "tsx scripts/demo-hl7.ts",
    "demo:outbound": "tsx scripts/demo-outbound.ts",
    "demo:dicom": "tsx scripts/demo-dicom.ts",
    "demo:mwl": "tsx scripts/demo-mwl.ts",
    "demo:db": "DATABASE_URL=postgres://hub:hub@localhost:5434/hub tsx scripts/demo.ts",
    "demo:update": "tsx scripts/demo-update.ts",
    "start:supervised": "tsx packages/server/src/supervisor-cli.ts",
    "update-cli": "tsx scripts/update-cli.ts",
    "key-cli": "tsx scripts/key-cli.ts",
    "tls:gen": "tsx scripts/gen-certs.ts",
    "image:build": "docker build -t medconnect-hub:0.1.0 .",
    "up:stack": "docker compose up -d --build hub",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}